# Variables d environnement (copier vers .env.local et remplir)

# Ollama Cloud (endpoint OpenAI-compatible)
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api/v1

# GitHub App (pour les automations)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Netlify (deploiement prod)
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# Turso (prod Netlify - migration depuis SQLite local)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=